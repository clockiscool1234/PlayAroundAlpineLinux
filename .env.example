# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here

# Optional: sync slash commands to a single guild for faster dev iteration
# GUILD_ID=123456789012345678

# Docker image used for user containers
CONTAINER_IMAGE=playaround-alpine-xorg:3.20

# Resource limits. CONTAINER_DISK is enforced only on a quota-capable Docker
# data root (classic overlay2 on XFS with pquota, or btrfs/zfs with quotas).
# Docker 29's containerd image store (Storage Driver: overlayfs) ignores it;
# disable it with features.containerd-snapshotter=false. The bot refuses to
# create a container when the quota cannot be verified.
CONTAINER_MEMORY=512m
CONTAINER_DISK=1g
CONTAINER_CPUS=1.0
CONTAINER_PIDS_LIMIT=128

# Optional: make /proc/meminfo and /proc/cpuinfo inside each user container
# reflect its cgroup limits instead of host totals (fastfetch, free, nproc).
# Install and start lxcfs on the host, then set this to /var/lib/lxcfs.
CONTAINER_LXCFS_PATH=

# Internal Docker network and filtering proxy created by compose.yaml.
# User containers have no direct Internet route; HTTP(S) exits through this proxy.
# Set CONTAINER_NETWORK_ENABLED=false to give user containers no network at all;
# CONTAINER_NETWORK and CONTAINER_HTTP_PROXY are then ignored.
CONTAINER_NETWORK_ENABLED=true
CONTAINER_NETWORK=alpine-filtered
CONTAINER_HTTP_PROXY=http://172.30.0.2:3128

# SQLite database path
DATABASE_PATH=data/bot.db

# Defaults assigned to newly created user containers.
USER_DEFAULTS_PATH=config/user-defaults.toml

# Optional tmate SSH access (compose.tmate.yaml). The public tmate.io relay was
# shut down in 2025, so this stack runs its own relay.
# TMATE_SSH_HOST is the hostname or IP users connect to; it must be reachable.
# TMATE_SSH_PORT is the externally reachable SSH port advertised to users.
# TMATE_PUBLISH_PORT is the host port mapped to the relay's internal port 2222.
# TMATE_SERVER_HOST/PORT describe where the client inside user containers
# reaches the relay; the defaults work with compose.tmate.yaml.
# TMATE_SERVER_RSA_FINGERPRINT/TMATE_SERVER_ED25519_FINGERPRINT are optional
# overrides; otherwise the bot reads data/tmate/ssh_host_*.pub.
TMATE_SSH_HOST=
TMATE_SSH_PORT=2222
TMATE_PUBLISH_PORT=2222
# TMATE_SERVER_HOST=tmate
# TMATE_SERVER_PORT=2222
# TMATE_KEYS_PATH=data/tmate
# TMATE_SERVER_RSA_FINGERPRINT=SHA256:...
# TMATE_SERVER_ED25519_FINGERPRINT=SHA256:...
