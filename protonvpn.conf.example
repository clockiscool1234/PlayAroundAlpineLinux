# Copy to protonvpn.conf and replace the placeholders with the values from
# the WireGuard configuration generated by ProtonVPN:
#   ProtonVPN dashboard -> Downloads -> WireGuard configuration.
#
# protonvpn.conf is gitignored and must not be committed. Restrict it with:
#   chmod 600 protonvpn.conf
#
# Keep Gluetun's mount path in mind: it reads this file as
# /gluetun/wireguard/wg0.conf. The comments ProtonVPN adds (for example
# "# Bouncing = 3" or "# JP-FREE#34") are harmless.

[Interface]
PrivateKey = REPLACE_WITH_PROTONVPN_PRIVATE_KEY
Address = 10.2.0.2/32, 2a07:b944::2:2/128
DNS = 10.2.0.1

[Peer]
PublicKey = REPLACE_WITH_PROTONVPN_SERVER_PUBLIC_KEY
AllowedIPs = 0.0.0.0/0, ::/0
Endpoint = 203.0.113.10:51820
PersistentKeepalive = 25