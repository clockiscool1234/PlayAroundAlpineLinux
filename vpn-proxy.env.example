# Copy to vpn-proxy.env and fill in. vpn-proxy.env is gitignored.
#
# Internal authentication between Squid and Gluetun's HTTP proxy. Use long
# random values containing only letters, digits, '.', '_', '~', and '-'.
# These credentials do not grant access to your ProtonVPN account.

HTTPPROXY_USER=alpinevpn
HTTPPROXY_PASSWORD=replace-with-a-long-random-password