# Copy to vpn.env and fill in. vpn.env is gitignored.
#
# Read only by the Gluetun VPN container. The WireGuard private key is not
# passed to the bot or to network-filter.

VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard

# ProtonVPN dashboard > Downloads > WireGuard configuration > PrivateKey.
WIREGUARD_PRIVATE_KEY=replace-with-your-wireguard-private-key

# Narrow the exit location if wanted. An empty value lets Gluetun choose.
SERVER_COUNTRIES=Netherlands
# SERVER_CITIES=
# SERVER_REGIONS=
# SERVER_HOSTNAMES=